# Database — Supabase Postgres (use the SESSION pooler :5432 for migrations,
# the TRANSACTION pooler :6543 with ?pgbouncer=true for serverless runtimes)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Auth — random 32+ char string used to sign the staff session JWTs
AUTH_SECRET=

# Realtime — shared secret between the Next.js server and the socket.io mini-service
REALTIME_SECRET=

# Optional — public socket.io endpoint for realtime clients.
# EMPTY on hosts without a socket service (serverless): every surface
# automatically falls back to its polling interval.
NEXT_PUBLIC_REALTIME_URL=
